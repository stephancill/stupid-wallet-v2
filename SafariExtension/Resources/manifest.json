{
  "name": "stupid wallet",
  "description": "EIP-1193 Ethereum provider with canonical request review",
  "version": "0.1.39",
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_icon": {
      "16": "toolbar-icon-16.png",
      "19": "toolbar-icon-19.png",
      "32": "toolbar-icon-32.png",
      "38": "toolbar-icon-38.png"
    },
    "default_title": "stupid wallet",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon-48.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["provider.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
