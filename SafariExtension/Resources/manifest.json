{
    "name": "Stupid Wallet",
    "description": "EIP-1193 Ethereum provider prototype with signl message review",
    "version": "0.1.0",
    "manifest_version": 3,
    "minimum_chrome_version": "111",
    "icons": {
        "48": "icon-48.png",
        "128": "icon-128.png"
    },
    "permissions": [
        "nativeMessaging",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_title": "Stupid Wallet",
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [ "<all_urls>" ],
            "js": [ "provider.js" ],
            "run_at": "document_idle",
            "world": "MAIN"
        },
        {
            "matches": [ "<all_urls>" ],
            "js": [ "bridge.js" ],
            "run_at": "document_idle"
        }
    ]
}